@using BookClient.Models.Book
@model List<Book>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card book-card h-100">
                    <div class="book-image-wrapper">
                        <img src="@(book.ImageUrl ?? "https://via.placeholder.com/200x300?text=No+Image")" 
                             class="card-img-top book-thumbnail" 
                             alt="@book.Title"
                             onerror="this.src='https://via.placeholder.com/200x300?text=No+Image'">
                        
                        @if (book.Discount > 0)
                        {
                            <div class="discount-badge-small">
                                -@book.Discount.ToString("0")%
                            </div>
                        }

                        @if (book.Stock == 0)
                        {
                            <div class="stock-badge">
                                Out of Stock
                            </div>
                        }
                    </div>
                    
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title book-title-small">
                            <a asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none">
                                @book.Title
                            </a>
                        </h6>
                        <p class="card-text book-author-small text-muted">@book.AuthorName</p>
                        
                        <div class="book-price-small mt-auto">
                            @if (book.Discount > 0)
                            {
                                var discountedPrice = book.Price * (1 - book.Discount / 100);
                                <div class="price-display">
                                    <span class="current-price-small">@discountedPrice.ToString("N0") VND</span>
                                    <span class="original-price-small">@book.Price.ToString("N0") VND</span>
                                </div>
                            }
                            else
                            {
                                <div class="price-display">
                                    <span class="current-price-small">@book.Price.ToString("N0") VND</span>
                                </div>
                            }
                        </div>

                        <div class="book-actions-small mt-2">
                            <a asp-action="Details" asp-route-id="@book.BookID" class="btn btn-primary btn-sm w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-4">
        <p class="text-muted">No related books found.</p>
    </div>
}

<style>
    .book-card {
        transition: transform 0.2s;
        border: 1px solid #ddd;
    }

    .book-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .book-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .book-thumbnail {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    .discount-badge-small {
        position: absolute;
        top: 8px;
        right: 8px;
        background: #dc3545;
        color: white;
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 0.7em;
        font-weight: bold;
    }

    .stock-badge {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.7em;
    }

    .book-title-small {
        font-size: 0.9rem;
        line-height: 1.3;
        height: 2.6rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .book-author-small {
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
    }

    .current-price-small {
        color: #28a745;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .original-price-small {
        text-decoration: line-through;
        color: #999;
        font-size: 0.8rem;
        margin-left: 5px;
    }

    .book-actions-small .btn {
        font-size: 0.8rem;
        padding: 4px 8px;
    }
</style>