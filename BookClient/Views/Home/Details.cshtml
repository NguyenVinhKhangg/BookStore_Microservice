@using BookClient.Models.Book
@model Book
@{
    ViewData["Title"] = Model.Title + " - Book Details";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" asp-route-categoryIds="@Model.CategoryID">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Book Image -->
        <div class="col-lg-4 col-md-5 mb-4">
            <div class="book-image-container">
                <img src="@(Model.ImageUrl ?? "https://via.placeholder.com/400x600?text=No+Image")"
                     alt="@Model.Title"
                     class="img-fluid rounded shadow book-detail-image"
                     onerror="this.src='https://via.placeholder.com/400x600?text=No+Image'" />

                @if (Model.Discount > 0)
                {
                    <div class="discount-badge">
                        <span>-@Model.Discount.ToString("0")%</span>
                    </div>
                }

                @if (Model.Stock == 0)
                {
                    <div class="stock-overlay">
                        <span class="out-of-stock">Out of Stock</span>
                    </div>
                }
            </div>
        </div>

        <!-- Book Information -->
        <div class="col-lg-8 col-md-7">
            <div class="book-details">
                <!-- Title & Author -->
                <div class="book-header mb-3">
                    <h1 class="book-title">@Model.Title</h1>
                    <p class="book-author">by <strong>@Model.AuthorName</strong></p>
                    <p class="book-publisher">Published by <em>@Model.PublisherName</em></p>
                </div>

                <!-- Category -->
                <div class="book-category mb-3">
                    <span class="badge badge-category">
                        <i class="fas fa-tag"></i> @Model.CategoryName
                    </span>
                </div>

                <!-- Pricing -->
                <div class="book-pricing mb-4">
                    @if (Model.Discount > 0)
                    {
                        var discountedPrice = Model.Price * (1 - Model.Discount / 100);
                        <div class="price-container">
                            <span class="current-price">@discountedPrice.ToString("N0") VND</span>
                            <span class="original-price">@Model.Price.ToString("N0") VND</span>
                            <span class="discount-percent">@Model.Discount.ToString("0")% OFF</span>
                        </div>
                        <div class="savings">
                            You save: <strong>@((Model.Price - discountedPrice).ToString("N0")) VND</strong>
                        </div>
                    }
                    else
                    {
                        <div class="price-container">
                            <span class="current-price">@Model.Price.ToString("N0") VND</span>
                        </div>
                    }
                </div>

                <!-- Stock Status -->
                <div class="stock-status mb-4">
                    @if (Model.Stock > 0)
                    {
                        <span class="stock-available">
                            <i class="fas fa-check-circle"></i>
                            <strong>In Stock</strong> (@Model.Stock units available)
                        </span>
                    }
                    else
                    {
                        <span class="stock-unavailable">
                            <i class="fas fa-times-circle"></i>
                            <strong>Out of Stock</strong>
                        </span>
                    }
                </div>

                <!-- Book Details -->
                <div class="book-specifications mb-4">
                    <h5>Book Details</h5>
                    <div class="row">
                        <div class="col-sm-6">
                            <ul class="list-unstyled">
                                <li><strong>ISBN:</strong> @Model.ISBN</li>
                                <li><strong>Author:</strong> @Model.AuthorName</li>
                                <li><strong>Publisher:</strong> @Model.PublisherName</li>
                            </ul>
                        </div>
                        <div class="col-sm-6">
                            <ul class="list-unstyled">
                                <li><strong>Category:</strong> @Model.CategoryName</li>
                                <li><strong>Stock:</strong> @Model.Stock units</li>
                                <li>
                                    <strong>Status:</strong>
                                    @if (Model.IsActive)
                                    {
                                        <span class="text-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Not Available</span>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="book-description mb-4">
                        <h5>Description</h5>
                        <div class="description-content">
                            @Html.Raw(Model.Description.Replace("\n", "<br/>"))
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="book-actions">
                    <div class="row">
                        <div class="col-md-8">
                            @if (Model.Stock > 0 && Model.IsActive)
                            {
                                <form method="post" asp-controller="Carts" asp-action="AddToCart" class="add-to-cart-form">
                                    <div class="quantity-selector mb-3">
                                        <label for="quantity">Quantity:</label>
                                        <div class="input-group quantity-input">
                                            <button type="button" class="btn btn-outline-secondary quantity-btn" data-action="decrease">-</button>
                                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control text-center" readonly>
                                            <button type="button" class="btn btn-outline-secondary quantity-btn" data-action="increase">+</button>
                                        </div>
                                    </div>

                                    <input type="hidden" name="bookId" value="@Model.BookID" />

                                    <div class="action-buttons">
                                        <button type="submit" class="btn btn-primary btn-lg add-to-cart-btn">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </button>
                                        <button type="button" class="btn btn-success btn-lg buy-now-btn">
                                            <i class="fas fa-bolt"></i> Buy Now
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="unavailable-actions">
                                    <button class="btn btn-secondary btn-lg" disabled>
                                        <i class="fas fa-times"></i> Currently Unavailable
                                    </button>
                                    <button type="button" class="btn btn-outline-primary notify-btn">
                                        <i class="fas fa-bell"></i> Notify When Available
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="secondary-actions">
                                <button type="button" class="btn btn-outline-danger wishlist-btn">
                                    <i class="far fa-heart"></i> Add to Wishlist
                                </button>
                                <button type="button" class="btn btn-outline-info share-btn">
                                    <i class="fas fa-share-alt"></i> Share
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Back Button -->
                <div class="mt-4">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Books
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Books Section -->
    <div class="related-books-section mt-5">
        <h3>Related Books</h3>
        <div id="related-books-container">
            <!-- Related books will be loaded here via AJAX -->
            <div class="text-center py-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .book-image-container {
        position: relative;
        text-align: center;
    }

    .book-detail-image {
        max-height: 600px;
        width: auto;
        border: 1px solid #ddd;
    }

    .discount-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 15px;
        font-weight: bold;
        font-size: 0.9em;
    }

    .stock-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .out-of-stock {
        color: white;
        font-size: 1.5em;
        font-weight: bold;
        text-transform: uppercase;
    }

    .book-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .book-author {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 0.3rem;
    }

    .book-publisher {
        font-size: 1rem;
        color: #888;
    }

    .badge-category {
        background: #007bff;
        color: white;
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 0.9em;
    }

    .price-container {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .current-price {
        font-size: 2rem;
        font-weight: bold;
        color: #28a745;
    }

    .original-price {
        font-size: 1.2rem;
        text-decoration: line-through;
        color: #999;
    }

    .discount-percent {
        background: #dc3545;
        color: white;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 0.8em;
        font-weight: bold;
    }

    .savings {
        color: #28a745;
        font-weight: bold;
    }

    .stock-available {
        color: #28a745;
        font-size: 1.1rem;
    }

    .stock-unavailable {
        color: #dc3545;
        font-size: 1.1rem;
    }

    .book-specifications {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid #007bff;
    }

    .description-content {
        line-height: 1.6;
        color: #555;
    }

    .quantity-input {
        max-width: 150px;
    }

    .quantity-btn {
        width: 40px;
    }

    .add-to-cart-btn, .buy-now-btn {
        min-width: 140px;
        margin-right: 10px;
        margin-bottom: 10px;
    }

    .secondary-actions .btn {
        width: 100%;
        margin-bottom: 10px;
    }

    .related-books-section {
        border-top: 1px solid #ddd;
        padding-top: 30px;
    }

    @@media (max-width: 768px) {
        .book-title

    {
        font-size: 1.8rem;
    }

    .current-price {
        font-size: 1.5rem;
    }

    .action-buttons .btn {
        width: 100%;
        margin-bottom: 10px;
    }

    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Quantity selector
            $('.quantity-btn').click(function() {
                var action = $(this).data('action');
                var input = $('#quantity');
                var currentVal = parseInt(input.val());
                var max = parseInt(input.attr('max'));

                if (action === 'increase' && currentVal < max) {
                    input.val(currentVal + 1);
                } else if (action === 'decrease' && currentVal > 1) {
                    input.val(currentVal - 1);
                }
            });

            // Buy Now button
            $('.buy-now-btn').click(function() {
                var form = $('.add-to-cart-form');
                form.attr('action', '@Url.Action("BuyNow", "Orders")');
                form.submit();
            });

            // Wishlist button
            $('.wishlist-btn').click(function() {
                // Add to wishlist functionality
                alert('Added to wishlist!');
            });

            // Share button
            $('.share-btn').click(function() {
                if (navigator.share) {
                    navigator.share({
                        title: '@Model.Title',
                        text: 'Check out this book: @Model.Title by @Model.AuthorName',
                        url: window.location.href
                    });
                } else {
                    // Fallback: copy to clipboard
                    navigator.clipboard.writeText(window.location.href);
                    alert('Link copied to clipboard!');
                }
            });

            // Notify when available
            $('.notify-btn').click(function() {
                alert('You will be notified when this book becomes available!');
            });

            // Load related books
            loadRelatedBooks();
        });

        function loadRelatedBooks() {
            $.ajax({
                url: '@Url.Action("GetRelatedBooks", "Home")',
                data: { categoryId: @Model.CategoryID, currentBookId: @Model.BookID },
                success: function(data) {
                    $('#related-books-container').html(data);
                },
                error: function() {
                    $('#related-books-container').html('<p class="text-muted">Unable to load related books.</p>');
                }
            });
        }
    </script>
}