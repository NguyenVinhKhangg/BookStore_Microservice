@model AdminUI.Models.Book.UpdateBookViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sách";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categoryOptions = ViewBag.CategoryOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Chỉnh sửa sách</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Quản lý sách</a></li>
                        <li class="breadcrumb-item active">Chỉnh sửa</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-edit"></i>
                        Cập nhật thông tin sách
                    </h3>
                </div>
                
                <form asp-action="Edit" method="post">
                    <input asp-for="BookID" type="hidden">
                    
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Title" class="required">Tiêu đề sách</label>
                                    <input asp-for="Title" class="form-control">
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ISBN" class="required">ISBN</label>
                                    <input asp-for="ISBN" class="form-control">
                                    <span asp-validation-for="ISBN" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="AuthorName" class="required">Tác giả</label>
                                    <input asp-for="AuthorName" class="form-control">
                                    <span asp-validation-for="AuthorName" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="PublisherName" class="required">Nhà xuất bản</label>
                                    <input asp-for="PublisherName" class="form-control">
                                    <span asp-validation-for="PublisherName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="CategoryID" class="required">Danh mục</label>
                                    <select asp-for="CategoryID" class="form-control">
                                        <option value="">Chọn danh mục</option>
                                        @foreach (var option in categoryOptions)
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CategoryID" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Price" class="required">Giá (VND)</label>
                                    <input asp-for="Price" class="form-control" type="number" step="1000" min="0">
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Discount">Giảm giá (%)</label>
                                    <input asp-for="Discount" class="form-control" type="number" step="0.1" min="0" max="100">
                                    <span asp-validation-for="Discount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="ImageUrl">URL hình ảnh</label>
                                    <input asp-for="ImageUrl" class="form-control">
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Description">Mô tả</label>
                                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="custom-control custom-switch">
                                        <input asp-for="IsActive" class="custom-control-input" type="checkbox">
                                        <label asp-for="IsActive" class="custom-control-label">Hiển thị sách</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Lưu ý:</strong> Để cập nhật số lượng tồn kho, vui lòng sử dụng chức năng quản lý kho.
                        </div>
                    </div>

                    <div class="card-footer">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}