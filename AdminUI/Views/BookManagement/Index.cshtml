@model List<AdminUI.Models.Book.BookViewModel>
@using AdminUI.Models.Book
@{
    ViewData["Title"] = "Book Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var filter = ViewBag.Filter as BookSearchFilterViewModel;
    var totalCount = ViewBag.TotalCount ?? 0;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalPages = ViewBag.TotalPages ?? 0;
    var categoryOptions = ViewBag.CategoryOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="fade-in-up">
    <!-- Search and Filter Section -->
    <div class="search-filter-container">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="SearchTerm" class="form-label">
                    <i class="fas fa-search"></i> Search
                </label>
                <input type="text" class="form-control" name="searchTerm" value="@filter?.SearchTerm" 
                       placeholder="Search by title, ISBN, author..." />
            </div>
            <div class="col-md-3">
                <label for="CategoryFilter" class="form-label">
                    <i class="fas fa-tags"></i> Category
                </label>
                <select class="form-select" name="categoryFilter">
                    <option value="">All Categories</option>
                    @foreach (var option in categoryOptions)
                    {
                        <option value="@option.Value" selected="@(filter?.CategoryFilter?.ToString() == option.Value)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="IsActiveFilter" class="form-label">
                    <i class="fas fa-toggle-on"></i> Status
                </label>
                <select class="form-select" name="isActiveFilter">
                    <option value="">All Status</option>
                    <option value="true" selected="@(filter?.IsActiveFilter == true)">Active</option>
                    <option value="false" selected="@(filter?.IsActiveFilter == false)">Hidden</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="PageSize" class="form-label">
                    <i class="fas fa-list"></i> Page Size
                </label>
                <select class="form-select" name="pageSize">
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-undo"></i> Reset
                </a>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Add New Book
                </a>
            </div>
        </form>
    </div>

    <!-- Results Info -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="results-info">
            <span class="text-muted">
                Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalCount) 
                of @totalCount results
            </span>
        </div>
        <div class="view-options">
            <span class="text-muted">Page @currentPage of @totalPages</span>
        </div>
    </div>

    <!-- Books Table -->
    <div class="admin-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="fas fa-hashtag"></i> ID</th>
                    <th><i class="fas fa-book"></i> Book</th>
                    <th><i class="fas fa-barcode"></i> ISBN</th>
                    <th><i class="fas fa-user-edit"></i> Author</th>
                    <th><i class="fas fa-tags"></i> Category</th>
                    <th><i class="fas fa-dollar-sign"></i> Price</th>
                    <th><i class="fas fa-boxes"></i> Stock</th>
                    <th><i class="fas fa-toggle-on"></i> Status</th>
                    <th><i class="fas fa-calendar"></i> Created</th>
                    <th><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td><strong>#@book.BookID</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="book-cover me-3">
                                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                                        {
                                            <img src="@book.ImageUrl" alt="@book.Title" class="img-thumbnail" 
                                                 style="width: 50px; height: 75px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded d-flex align-items-center justify-content-center" 
                                                 style="width: 50px; height: 75px;">
                                                <i class="fas fa-book text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold">@book.Title</div>
                                        @if (!string.IsNullOrEmpty(book.Description) && book.Description.Length > 50)
                                        {
                                            <small class="text-muted">@book.Description.Substring(0, 50)...</small>
                                        }
                                        @if (book.Discount > 0)
                                        {
                                            <br><small class="text-success">
                                                <i class="fas fa-percent"></i> @book.Discount% discount
                                            </small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code>@book.ISBN</code>
                            </td>
                            <td>
                                <div>
                                    <strong>@book.AuthorName</strong>
                                    @if (!string.IsNullOrEmpty(book.PublisherName))
                                    {
                                        <br><small class="text-muted">@book.PublisherName</small>
                                    }
                                </div>
                            </td>
                            <td>
                                @{
                                    var categoryName = categoryOptions.FirstOrDefault(c => c.Value == book.CategoryID.ToString())?.Text ?? "Unknown";
                                }
                                <span class="badge bg-light text-dark">@categoryName</span>
                            </td>
                            <td>
                                <strong class="text-success">@book.Price.ToString("C")</strong>
                                @if (book.Discount > 0)
                                {
                                    var discountedPrice = book.Price * (1 - book.Discount / 100);
                                    <br><small class="text-muted"><s>@discountedPrice.ToString("C")</s></small>
                                }
                            </td>
                            <td>
                                @if (book.Stock > 0)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check"></i> @book.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times"></i> Out of Stock
                                    </span>
                                }
                            </td>
                            <td>
                                @if (book.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-eye"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-eye-slash"></i> Hidden
                                    </span>
                                }
                            </td>
                            <td>
                                <small>@book.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button type="button" class="btn btn-sm btn-info" 
                                            onclick="showBookDetail(@book.BookID)" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@book.BookID" 
                                       class="btn btn-sm btn-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (book.IsActive)
                                    {
                                        <button type="button" class="btn btn-sm btn-warning" 
                                                onclick="hideBook(@book.BookID)" title="Hide Book">
                                            <i class="fas fa-eye-slash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-success" 
                                                onclick="unhideBook(@book.BookID)" title="Show Book">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5">
                            <div class="no-data">
                                <i class="fas fa-books fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No books found</h5>
                                <p class="text-muted">Try adjusting your search criteria or add a new book.</p>
                                <a asp-action="Create" class="btn btn-success">
                                    <i class="fas fa-plus"></i> Add New Book
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Book pagination">
            <ul class="pagination">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = filter?.SearchTerm, 
                            categoryFilter = filter?.CategoryFilter,
                            isActiveFilter = filter?.IsActiveFilter,
                            sortBy = filter?.SortBy,
                            sortOrder = filter?.SortOrder,
                            pageSize = pageSize, 
                            page = 1 })">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = filter?.SearchTerm, 
                            categoryFilter = filter?.CategoryFilter,
                            isActiveFilter = filter?.IsActiveFilter,
                            sortBy = filter?.SortBy,
                            sortOrder = filter?.SortOrder,
                            pageSize = pageSize, 
                            page = currentPage - 1 })">
                            <i class="fas fa-angle-left"></i>
                        </a>
                    </li>
                }

                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = filter?.SearchTerm, 
                            categoryFilter = filter?.CategoryFilter,
                            isActiveFilter = filter?.IsActiveFilter,
                            sortBy = filter?.SortBy,
                            sortOrder = filter?.SortOrder,
                            pageSize = pageSize, 
                            page = i })">@i</a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = filter?.SearchTerm, 
                            categoryFilter = filter?.CategoryFilter,
                            isActiveFilter = filter?.IsActiveFilter,
                            sortBy = filter?.SortBy,
                            sortOrder = filter?.SortOrder,
                            pageSize = pageSize, 
                            page = currentPage + 1 })">
                            <i class="fas fa-angle-right"></i>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            searchTerm = filter?.SearchTerm, 
                            categoryFilter = filter?.CategoryFilter,
                            isActiveFilter = filter?.IsActiveFilter,
                            sortBy = filter?.SortBy,
                            sortOrder = filter?.SortOrder,
                            pageSize = pageSize, 
                            page = totalPages })">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Book Detail Modal -->
<div class="modal fade" id="bookDetailModal" tabindex="-1" aria-labelledby="bookDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookDetailModalLabel">
                    <i class="fas fa-book"></i> Book Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bookDetailContent">
                <!-- Book detail content will be loaded here -->
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Close
                </button>
                <button type="button" class="btn btn-primary" id="editBookFromModal">
                    <i class="fas fa-edit"></i> Edit Book
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showBookDetail(bookId) {
            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('bookDetailModal'));
            modal.show();

            // Reset content
            document.getElementById('bookDetailContent').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2 text-muted">Loading book details...</div>
                </div>
            `;

            // Load book details
            fetch(`/BookManagement/GetBookDetail/${bookId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    document.getElementById('bookDetailContent').innerHTML = html;
                    
                    // Update edit button
                    document.getElementById('editBookFromModal').onclick = function() {
                        modal.hide();
                        window.location.href = `/BookManagement/Edit/${bookId}`;
                    };
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('bookDetailContent').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> 
                            Failed to load book details. Please try again.
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="showBookDetail(${bookId})">
                                <i class="fas fa-redo"></i> Retry
                            </button>
                        </div>
                    `;
                });
        }

        function hideBook(bookId) {
            if (confirm('Are you sure you want to hide this book? It will not be visible to customers.')) {
                fetch(`/BookManagement/Hide/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Failed to hide book.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while hiding the book.');
                });
            }
        }

        function unhideBook(bookId) {
            if (confirm('Are you sure you want to show this book? It will be visible to customers again.')) {
                fetch(`/BookManagement/Unhide/${bookId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Failed to show book.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while showing the book.');
                });
            }
        }

        // Auto-refresh category dropdown if needed
        document.addEventListener('DOMContentLoaded', function() {
            const categorySelect = document.querySelector('select[name="categoryFilter"]');
            if (categorySelect && categorySelect.options.length <= 1) {
                console.warn('Categories not loaded. Check category service.');
            }
        });
    </script>
}