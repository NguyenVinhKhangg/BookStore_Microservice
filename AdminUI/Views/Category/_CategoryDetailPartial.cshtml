@model AdminUI.Models.Category.CategoryViewModel

@if (Model != null)
{
    <div class="category-detail">
        <div class="row">
            <div class="col-md-6">
                <div class="info-group">
                    <label class="info-label">
                        <i class="fas fa-hashtag"></i> Category ID
                    </label>
                    <div class="info-value">
                        <span class="badge bg-primary">#@Model.CategoryID</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-group">
                    <label class="info-label">
                        <i class="fas fa-toggle-on"></i> Status
                    </label>
                    <div class="info-value">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="fas fa-times-circle"></i> Inactive
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="info-group">
                    <label class="info-label">
                        <i class="fas fa-tag"></i> Category Name
                    </label>
                    <div class="info-value">
                        <h5 class="mb-0">@Model.Name</h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="info-group">
                    <label class="info-label">
                        <i class="fas fa-align-left"></i> Description
                    </label>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="mb-0">@Model.Description</p>
                        }
                        else
                        {
                            <em class="text-muted">No description provided</em>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.CategoryID" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i> Edit Category
                    </a>
                    
                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.CategoryID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-warning btn-sm" 
                                    onclick="return confirm('Are you sure you want to deactivate this category?')">
                                <i class="fas fa-ban"></i> Deactivate
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.CategoryID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-sm" 
                                    onclick="return confirm('Are you sure you want to activate this category?')">
                                <i class="fas fa-check"></i> Activate
                            </button>
                        </form>
                    }
                    
                    <form asp-action="Delete" asp-route-id="@Model.CategoryID" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" 
                                onclick="return confirm('Are you sure you want to delete this category? This action cannot be undone.')">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <style>
        .info-group {
            margin-bottom: 1rem;
        }
        .info-label {
            font-weight: 600;
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 0.25rem;
            display: block;
        }
        .info-value {
            font-size: 1rem;
        }
        .category-detail {
            padding: 1rem;
        }
    </style>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        Category details not found.
    </div>
}