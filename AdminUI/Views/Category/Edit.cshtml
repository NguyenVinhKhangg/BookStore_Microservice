@model AdminUI.Models.Category.UpdateCategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="fade-in-up">
    <div class="admin-card">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-edit"></i> Edit Category
                <span class="badge bg-primary ms-2">#@Model.CategoryID</span>
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" id="editCategoryForm">
                <input asp-for="CategoryID" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="fas fa-tag"></i> @Html.DisplayNameFor(m => m.Name) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="IsActive" class="form-label">
                                <i class="fas fa-toggle-on"></i> @Html.DisplayNameFor(m => m.IsActive)
                            </label>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch" id="statusLabel">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                <i class="fas fa-align-left"></i> @Html.DisplayNameFor(m => m.Description)
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4" 
                                      placeholder="Enter category description (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle"></i> Provide a brief description to help users understand this category.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-primary" id="updateBtn">
                        <i class="fas fa-save"></i> Update Category
                    </button>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.CategoryID" class="btn btn-info">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('editCategoryForm');
            const updateBtn = document.getElementById('updateBtn');
            const isActiveSwitch = document.getElementById('isActiveSwitch');
            const statusLabel = document.getElementById('statusLabel');
            
            // Update label when switch changes
            isActiveSwitch.addEventListener('change', function() {
                statusLabel.textContent = this.checked ? 'Active' : 'Inactive';
                statusLabel.className = `form-check-label ${this.checked ? 'text-success' : 'text-danger'}`;
            });
            
            // Set initial label style
            statusLabel.className = `form-check-label ${isActiveSwitch.checked ? 'text-success' : 'text-danger'}`;
            
            form.addEventListener('submit', function(e) {
                // Disable button to prevent double submission
                updateBtn.disabled = true;
                updateBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
                
                // Re-enable button after 3 seconds (fallback)
                setTimeout(() => {
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = '<i class="fas fa-save"></i> Update Category';
                }, 3000);
            });

            // Real-time validation feedback
            const nameInput = document.getElementById('Name');
            nameInput.addEventListener('input', function() {
                const value = this.value.trim();
                const feedback = this.parentElement.querySelector('.validation-feedback');
                
                if (feedback) {
                    feedback.remove();
                }
                
                if (value.length > 0 && value.length < 2) {
                    this.classList.add('is-invalid');
                    const feedbackDiv = document.createElement('div');
                    feedbackDiv.className = 'invalid-feedback validation-feedback';
                    feedbackDiv.textContent = 'Category name must be at least 2 characters long.';
                    this.parentElement.appendChild(feedbackDiv);
                } else if (value.length > 100) {
                    this.classList.add('is-invalid');
                    const feedbackDiv = document.createElement('div');
                    feedbackDiv.className = 'invalid-feedback validation-feedback';
                    feedbackDiv.textContent = 'Category name cannot exceed 100 characters.';
                    this.parentElement.appendChild(feedbackDiv);
                } else {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                }
            });
        });
    </script>
}